# Local development only: copy these values into your IDE run configuration or a
# local .env file that is never committed. In Azure, source them from Key Vault.
DB_URL=jdbc:mysql://your-mysql-host:3306/your_database?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_a_secret
JWT_SECRET=replace_with_a_long_random_secret
MONGODB_URI=mongodb://your-mongodb-host:27017/vidya_chat
MYSQL_ROOT_PASSWORD=replace_with_a_secret
